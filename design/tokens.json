{
  "version": "0.1",
  "skylink": {
    "color": {
      "signal-teal": {
        "value": "#3CE0C9",
        "use": "primary action, active state, brand accent"
      },
      "midnight": {
        "value": "#0A0F1A",
        "use": "dark-mode ground, text on light"
      },
      "silver": {
        "value": "#DDE5E8",
        "use": "light-mode ground, dividers, dimmed diagram layers"
      },
      "coral": {
        "value": "#FF7A6A",
        "use": "warnings, 'get it checked soon'"
      },
      "stop-red": {
        "value": "#E03C3C",
        "use": "SOS button, 'stop driving now'"
      },
      "caution-amber": {
        "value": "#F2B138",
        "use": "'don't drive far', pending codes"
      },
      "safe-green": {
        "value": "#3CCB7F",
        "use": "'safe to drive', completed steps"
      }
    },
    "severity": {
      "safe": {
        "color": "safe-green",
        "icon": "checkmark.circle",
        "label": "Safe to drive"
      },
      "soon": {
        "color": "coral",
        "icon": "clock.badge",
        "label": "Get it checked soon"
      },
      "limited": {
        "color": "caution-amber",
        "icon": "exclamationmark.triangle",
        "label": "Don't drive far"
      },
      "stop": {
        "color": "stop-red",
        "icon": "hand.raised.fill",
        "label": "Stop driving now"
      }
    },
    "type": {
      "wordmark": "Geometric sans",
      "app": "SF Pro (system, for Dynamic Type)",
      "min-step-size-pt": 20,
      "min-sos-size-pt": 28,
      "figures": "tabular for specs, capacities, pressures"
    },
    "defaultAppearance": "dark"
  },
  "rules": [
    "Severity is never communicated by color alone: icon and word, always.",
    "Minimum 44pt touch targets.",
    "Dynamic Type to the largest accessibility sizes without truncation.",
    "Reduced-motion support on every animation.",
    "Every screen ships loading, empty, permission-denied, offline, and error states."
  ]
}
