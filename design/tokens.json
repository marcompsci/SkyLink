{
  "version": "0.1",
  "skylink": {
    "color": {
      "garage-black": {
        "value": "#121419",
        "use": "ground"
      },
      "steel": {
        "value": "#1C2028",
        "use": "cards, raised surfaces"
      },
      "chrome": {
        "value": "#DDE3EA",
        "use": "primary text, diagram line work"
      },
      "torque-orange": {
        "value": "#FF6B2C",
        "use": "primary action, Auto's accent \u2014 the only primary"
      },
      "shop-yellow": {
        "value": "#FFC53D",
        "use": "hazard stripes, caution, get-it-checked-soon"
      },
      "oil-teal": {
        "value": "#19C3B2",
        "use": "secondary action, safe to drive, completed steps"
      },
      "stop-red": {
        "value": "#E8402A",
        "use": "SOS, stop driving now"
      },
      "safe-green": {
        "value": "#3ECF8E",
        "use": "confirmations, passed checks"
      },
      "grease": {
        "value": "#6B7480",
        "use": "secondary text, dimmed diagram layers"
      }
    },
    "severity": {
      "safe": {
        "color": "safe-green",
        "icon": "checkmark.circle",
        "label": "Safe to drive",
        "auto": "found-it"
      },
      "soon": {
        "color": "shop-yellow",
        "icon": "clock.badge",
        "label": "Get it checked soon",
        "auto": "careful"
      },
      "limited": {
        "color": "torque-orange",
        "icon": "exclamationmark.triangle",
        "label": "Don't drive far",
        "auto": "careful"
      },
      "stop": {
        "color": "stop-red",
        "icon": "hand.raised.fill",
        "label": "Stop driving now",
        "auto": "stop"
      }
    },
    "type": {
      "display": "Archivo 800",
      "label": "Archivo Narrow 700, uppercase, tracked",
      "body": "Archivo 500/600",
      "app": "SF Pro where Dynamic Type must scale",
      "min-step-size-pt": 20,
      "min-sos-size-pt": 28
    },
    "defaultAppearance": "dark",
    "motif": {
      "hazard-stripe": {
        "angle": 45,
        "colors": [
          "shop-yellow",
          "garage-black"
        ],
        "use": "thin band at screen top and around the SOS button only"
      }
    },
    "auto": {
      "states": [
        "idle",
        "listening",
        "thinking",
        "found-it",
        "careful",
        "stop",
        "cant-help"
      ],
      "rule": "Auto's expression never appears without the matching word and icon."
    }
  },
  "rules": [
    "Severity is never communicated by color alone: icon and word, always.",
    "Minimum 44pt touch targets.",
    "Dynamic Type to the largest accessibility sizes without truncation.",
    "Reduced-motion support on every animation.",
    "Every screen ships loading, empty, permission-denied, offline, and error states.",
    "Torque Orange is the only primary action colour on a screen.",
    "Auto's states always pair his expression with the word and the icon.",
    "The hazard stripe appears at screen top and on SOS only."
  ]
}
